---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "OpenReef - Deploy AI agent teams in one command. Package and deploy coordinated AI agent formations to OpenClaw.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://openreef.ai/" />
    <meta property="og:image" content="https://openreef.ai/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts -->
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-display@700,600,500&f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
    />

    <!-- Theme persistence (prevent flash) -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('reef-theme');
        if (saved) {
          document.documentElement.setAttribute('data-theme', saved);
        } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
      <span class="theme-icon-dark">&#9790;</span>
      <span class="theme-icon-light">&#9728;</span>
    </button>

    <div class="stars"></div>
    <div class="nebula"></div>

    <slot />

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const html = document.documentElement;
        const current = html.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('reef-theme', next);
      });
    </script>
  </body>
</html>

<style is:global>
  /* ── Reset ── */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ── Design Tokens ── */
  :root {
    /* Deep ocean palette */
    --bg-deep: #030918;
    --bg-surface: #071028;
    --bg-elevated: #0f1a35;

    /* Reef blue spectrum (primary) */
    --reef-bright: #3b7dff;
    --reef-mid: #2563eb;
    --reef-dark: #1e40af;

    /* Living coral spectrum (secondary) */
    --coral-bright: #ff6f61;
    --coral-mid: #e85d50;
    --coral-dark: #b94a3f;

    /* Bioluminescent cyan (tertiary) */
    --cyan-bright: #00e5cc;
    --cyan-mid: #14b8a6;

    /* Text */
    --text-primary: #eef2ff;
    --text-secondary: #8892b0;
    --text-muted: #5a6480;

    /* Borders */
    --border-subtle: rgba(136, 146, 176, 0.15);
    --border-accent: rgba(59, 125, 255, 0.3);

    /* Surfaces */
    --surface-card: rgba(7, 16, 40, 0.65);
    --surface-card-strong: rgba(7, 16, 40, 0.8);

    /* Shadows */
    --shadow-reef: rgba(59, 125, 255, 0.25);
    --shadow-coral: rgba(255, 111, 97, 0.2);

    /* Fonts */
    --font-display: 'Clash Display', system-ui, sans-serif;
    --font-body: 'Satoshi', system-ui, sans-serif;
    --font-mono: 'SF Mono', 'Fira Code', 'JetBrains Mono', monospace;
  }

  /* ── Light Theme ── */
  html[data-theme='light'] {
    --bg-deep: #f8faff;
    --bg-surface: #ffffff;
    --bg-elevated: #eef3ff;

    --reef-bright: #2563eb;
    --reef-mid: #1d4ed8;
    --reef-dark: #1e3a8a;

    --coral-bright: #e85d50;
    --coral-mid: #dc2626;
    --coral-dark: #991b1b;

    --cyan-bright: #008f87;
    --cyan-mid: #00766e;

    --text-primary: #0b1220;
    --text-secondary: #2e405c;
    --text-muted: #5f7290;

    --border-subtle: rgba(15, 23, 42, 0.12);
    --border-accent: rgba(37, 99, 235, 0.3);

    --surface-card: rgba(255, 255, 255, 0.85);
    --surface-card-strong: rgba(255, 255, 255, 0.92);

    --shadow-reef: rgba(37, 99, 235, 0.15);
    --shadow-coral: rgba(232, 93, 80, 0.15);
  }

  html[data-theme='light'] body {
    background:
      radial-gradient(1200px circle at 12% -10%, rgba(37, 99, 235, 0.04), transparent 58%),
      radial-gradient(900px circle at 88% -12%, rgba(0, 143, 135, 0.05), transparent 56%),
      var(--bg-deep);
  }

  html[data-theme='light'] .stars,
  html[data-theme='light'] .nebula {
    display: none;
  }

  /* ── Global ── */
  body {
    font-family: var(--font-body);
    background: var(--bg-deep);
    color: var(--text-primary);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::selection {
    background: var(--reef-bright);
    color: var(--bg-deep);
  }

  a {
    color: var(--reef-bright);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--cyan-bright);
  }

  /* ── Theme Toggle ── */
  .theme-toggle {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 999;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    backdrop-filter: blur(12px);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .theme-toggle:hover {
    border-color: var(--reef-bright);
    transform: scale(1.1);
  }

  html[data-theme='dark'] .theme-icon-light { display: none; }
  html[data-theme='light'] .theme-icon-dark { display: none; }
  html[data-theme='dark'] .theme-icon-dark { display: inline; }
  html[data-theme='light'] .theme-icon-light { display: inline; }

  /* ── Stars Background ── */
  .stars {
    position: fixed;
    inset: 0;
    background-image:
      radial-gradient(2px 2px at 20px 30px, rgba(255,255,255,0.7), transparent),
      radial-gradient(2px 2px at 40px 70px, rgba(255,255,255,0.4), transparent),
      radial-gradient(1px 1px at 90px 40px, rgba(255,255,255,0.6), transparent),
      radial-gradient(2px 2px at 130px 80px, rgba(255,255,255,0.5), transparent),
      radial-gradient(1px 1px at 160px 30px, rgba(255,255,255,0.5), transparent),
      radial-gradient(2px 2px at 200px 60px, rgba(59,125,255,0.5), transparent),
      radial-gradient(1px 1px at 230px 90px, rgba(255,255,255,0.4), transparent),
      radial-gradient(2px 2px at 260px 20px, rgba(255,255,255,0.6), transparent),
      radial-gradient(1px 1px at 300px 70px, rgba(0,229,204,0.4), transparent),
      radial-gradient(2px 2px at 80px 110px, rgba(255,255,255,0.3), transparent),
      radial-gradient(1px 1px at 180px 120px, rgba(255,111,97,0.4), transparent),
      radial-gradient(2px 2px at 320px 40px, rgba(59,125,255,0.3), transparent);
    background-size: 350px 150px;
    animation: twinkle 8s ease-in-out infinite alternate;
    pointer-events: none;
    z-index: 0;
  }

  @keyframes twinkle {
    from { opacity: 0.5; }
    to { opacity: 0.8; }
  }

  /* ── Nebula Background ── */
  .nebula {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 20% 20%, rgba(59, 125, 255, 0.1), transparent 50%),
      radial-gradient(ellipse 60% 60% at 80% 30%, rgba(0, 229, 204, 0.06), transparent 50%),
      radial-gradient(ellipse 90% 70% at 50% 90%, rgba(255, 111, 97, 0.05), transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  /* ── Entrance Animation ── */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
