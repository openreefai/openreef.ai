---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Stop hand-wiring AI agents. OpenReef lets you define your team in one manifest and deploy in seconds. One format, any runtime.",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />

    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://openreef.ai/" />
    <meta property="og:image" content="https://openreef.ai/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts: Cabinet Grotesk (display) + Inter (body) -->
    <link
      href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@700,800,500&display=swap"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NSJPGJRE2M" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NSJPGJRE2M');
    </script>

    <!-- Theme persistence (prevent flash) -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('reef-theme');
        if (saved) {
          document.documentElement.setAttribute('data-theme', saved);
        } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
      <span class="theme-icon-dark">&#9790;</span>
      <span class="theme-icon-light">&#9728;</span>
    </button>

    <!-- ── Background blobs ── -->
    <div class="bg-gradient"></div>

    <slot />

    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const html = document.documentElement;
        const current = html.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        html.setAttribute('data-theme', next);
        localStorage.setItem('reef-theme', next);
      });
    </script>
  </body>
</html>

<style is:global>
  /* ── Reset ── */
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* ── Design Tokens ── */
  :root {
    --bg-deep: #060b1a;
    --bg-surface: #0a1128;
    --bg-elevated: #111d3a;

    /* Reef blue spectrum (primary) */
    --reef-bright: #3b7dff;
    --reef-mid: #2563eb;
    --reef-dark: #1e40af;

    /* Living coral spectrum (secondary) */
    --coral-bright: #ff6f61;
    --coral-mid: #e85d50;
    --coral-dark: #b94a3f;

    /* Bioluminescent cyan (tertiary) */
    --cyan-bright: #00e5cc;
    --cyan-mid: #14b8a6;

    /* Text */
    --text-primary: #e8ecf4;
    --text-secondary: #8892b0;
    --text-muted: #5a6480;

    /* Borders */
    --border-subtle: rgba(136, 146, 176, 0.12);
    --border-accent: rgba(59, 125, 255, 0.3);

    /* Surfaces */
    --surface-card: #0d1529;
    --surface-card-hover: #111d3a;

    /* Shadows */
    --shadow-reef: rgba(59, 125, 255, 0.2);
    --shadow-coral: rgba(255, 111, 97, 0.15);

    /* Fonts */
    --font-display: 'Cabinet Grotesk', system-ui, sans-serif;
    --font-body: 'Inter', system-ui, sans-serif;
    --font-mono: 'SF Mono', 'Fira Code', 'JetBrains Mono', monospace;
  }

  /* ── Light Theme ── */
  html[data-theme='light'] {
    --bg-deep: #f6f8fc;
    --bg-surface: #ffffff;
    --bg-elevated: #edf1f8;

    --reef-bright: #2563eb;
    --reef-mid: #1d4ed8;
    --reef-dark: #1e3a8a;

    --coral-bright: #e85d50;
    --coral-mid: #dc2626;
    --coral-dark: #991b1b;

    --cyan-bright: #008f87;
    --cyan-mid: #00766e;

    --text-primary: #0f172a;
    --text-secondary: #334155;
    --text-muted: #64748b;

    --border-subtle: rgba(15, 23, 42, 0.1);
    --border-accent: rgba(37, 99, 235, 0.25);

    --surface-card: #ffffff;
    --surface-card-hover: #f1f5f9;

    --shadow-reef: rgba(37, 99, 235, 0.1);
    --shadow-coral: rgba(232, 93, 80, 0.1);
  }

  html[data-theme='light'] .bg-gradient {
    opacity: 0.4;
  }

  /* ── Global ── */
  body {
    font-family: var(--font-body);
    background: var(--bg-deep);
    color: var(--text-primary);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  ::selection {
    background: var(--reef-bright);
    color: #fff;
  }

  a {
    color: var(--reef-bright);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--cyan-bright);
  }

  /* ── Theme Toggle ── */
  .theme-toggle {
    position: fixed;
    top: 16px;
    right: 16px;
    z-index: 100;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition: all 0.2s ease;
  }

  .theme-toggle:hover {
    border-color: var(--reef-bright);
    background: var(--bg-elevated);
  }

  /* Dark mode: show sun (click to switch to light) */
  html[data-theme='dark'] .theme-icon-dark { display: none; }
  html[data-theme='dark'] .theme-icon-light { display: inline; color: #e8ecf4; }
  /* Light mode: show moon (click to switch to dark) */
  html[data-theme='light'] .theme-icon-light { display: none; }
  html[data-theme='light'] .theme-icon-dark { display: inline; color: #0f172a; }

  /* ── Background Gradient Blobs ── */
  .bg-gradient {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(600px circle at 15% 15%, rgba(59, 125, 255, 0.08), transparent),
      radial-gradient(500px circle at 85% 20%, rgba(0, 229, 204, 0.05), transparent),
      radial-gradient(700px circle at 60% 80%, rgba(255, 111, 97, 0.04), transparent);
    pointer-events: none;
    z-index: 0;
  }

  /* ── Entrance Animation ── */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
