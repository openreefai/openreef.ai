---
import Layout from '../layouts/Layout.astro';
---

<Layout title="OpenReef - The Open Standard for Multi-Agent Formations">
  <main class="container">
    <!-- ═══ Hero ═══ -->
    <section class="hero">
      <div class="hero-columns">
        <div class="hero-left">
          <div class="hero-icon">
            <div class="hero-glow"></div>
            <svg viewBox="0 0 100 100" class="reef-logo" aria-hidden="true">
              <defs>
                <linearGradient id="reef-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#3b7dff" />
                  <stop offset="50%" style="stop-color:#00e5cc" />
                  <stop offset="100%" style="stop-color:#ff6f61" />
                </linearGradient>
              </defs>
              <path d="M50 85 L50 55 M50 55 L35 35 M50 55 L65 35 M35 35 L25 18 M35 35 L42 20 M65 35 L58 20 M65 35 L75 18 M50 55 L50 30 M50 30 L43 15 M50 30 L57 15" stroke="url(#reef-grad)" stroke-width="4" stroke-linecap="round" fill="none" />
              <ellipse cx="50" cy="88" rx="18" ry="4" fill="url(#reef-grad)" opacity="0.3" />
            </svg>
          </div>
          <h1 class="hero-title">OpenReef</h1>
          <p class="hero-tagline">Agent teams as code</p>
          <p class="hero-description">
            One manifest defines your agents, their personalities, communication topology, and schedules.
            One command deploys them. The package manager for multi-agent systems.
          </p>
          <div class="hero-cta-row">
            <a href="https://tide.openreef.ai" class="btn btn-coral">Browse Formations</a>
            <a href="https://github.com/openreefai" target="_blank" rel="noopener" class="btn btn-ghost">GitHub</a>
            <a href="https://discord.gg/HaNqc266rS" target="_blank" rel="noopener" class="btn btn-ghost">Discord</a>
          </div>
        </div>

        <div class="hero-right">
          <div class="hero-bot-card">
            <div class="bot-card-header">
              <span class="bot-card-label">Your AI assistant</span>
              <span class="bot-card-dot"></span>
            </div>
            <div class="bot-card-body">
              <p class="bot-card-intro">Send your bot one line to get started:</p>
              <div class="bot-card-prompt">
                <code>Read and install https://www.openreef.ai/</code>
                <button class="bot-card-copy" aria-label="Copy prompt">Copy</button>
              </div>
              <div class="bot-card-result">
                <p class="bot-card-result-label">It will know how to:</p>
                <div class="bot-card-routes">
                  <div class="bot-card-route">
                    <span class="route-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    </span>
                    <span>Search formations</span>
                  </div>
                  <div class="bot-card-route">
                    <span class="route-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    </span>
                    <span>Install &amp; deploy</span>
                  </div>
                  <div class="bot-card-route">
                    <span class="route-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
                    </span>
                    <span>Create new formations</span>
                  </div>
                </div>
              </div>
              <p class="bot-card-footnote">Deterministic routing. No guessing. No unnecessary auth prompts.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ Quick Start ═══ -->
    <section class="section cli-section" id="quick-start">
      <p class="cli-connector">Or, from your terminal:</p>
      <div class="cli-prereq">
        <span class="terminal-prompt">$</span>
        <span class="terminal-cmd">npm i -g @openreef/cli</span>
      </div>
      <div class="cli-paths">
        <div class="cli-path">
          <span class="cli-path-label">Use a formation</span>
          <div class="terminal terminal-reveal">
            <div class="terminal-header">
              <span class="terminal-label">terminal</span>
              <button class="terminal-copy-btn" aria-label="Copy terminal commands">Copy</button>
            </div>
            <div class="terminal-body">
              <div class="terminal-line terminal-reveal-line" style="transition-delay: 0.1s">
                <span class="terminal-prompt">$</span>
                <span class="terminal-cmd">reef search "daily operations"</span>
              </div>
              <div class="terminal-line terminal-reveal-line" style="transition-delay: 0.3s">
                <span class="terminal-prompt">$</span>
                <span class="terminal-cmd">reef install daily-ops</span>
              </div>
              <div class="terminal-output terminal-reveal-line" style="transition-delay: 0.55s">
                <span class="terminal-success">✓ 5 agents deployed and running</span>
              </div>
            </div>
          </div>
        </div>
        <div class="cli-path">
          <span class="cli-path-label">Build your own</span>
          <div class="terminal terminal-reveal">
            <div class="terminal-header">
              <span class="terminal-label">terminal</span>
              <button class="terminal-copy-btn" aria-label="Copy terminal commands">Copy</button>
            </div>
            <div class="terminal-body">
              <div class="terminal-line terminal-reveal-line" style="transition-delay: 0.15s">
                <span class="terminal-prompt">$</span>
                <span class="terminal-cmd">reef init my-team --type shoal</span>
              </div>
              <div class="terminal-line terminal-reveal-line" style="transition-delay: 0.35s">
                <span class="terminal-prompt">$</span>
                <span class="terminal-cmd">reef install ./my-team</span>
              </div>
              <div class="terminal-output terminal-reveal-line" style="transition-delay: 0.6s">
                <span class="terminal-success">✓ Formation "my-team" deployed</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ What It Does ═══ -->
    <section class="section">
      <h2 class="section-title">What It Does</h2>
      <div class="comparison">
        <div class="card comparison-before">
          <h3>Without OpenReef</h3>
          <ul>
            <li>Manually create each agent</li>
            <li>Write personality files one by one</li>
            <li>Wire inter-agent communication by hand</li>
            <li>Configure tools for each agent</li>
            <li>Set up cron jobs individually</li>
            <li>No way to share, reproduce, or version your setup</li>
          </ul>
        </div>
        <div class="card comparison-after">
          <h3>With OpenReef</h3>
          <div class="inline-code">
            <code><span class="terminal-prompt">$</span> reef install daily-ops</code>
          </div>
          <p>5 agents. Wired up. Scheduled. Running. In seconds.</p>
          <ul>
            <li>One declarative manifest</li>
            <li>Reproducible every time</li>
            <li>Shareable and versionable</li>
            <li>Safe - no code execution, just data</li>
          </ul>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <!-- ═══ Formations in Action ═══ -->
    <section class="section section-featured">
      <h2 class="section-title">Formations in Action</h2>
      <p class="section-subtitle">Two real formations. Different architectures. Same install experience.</p>

      <div class="formations-diptych">
        <!-- daily-ops -->
        <div class="diptych-card diptych-blue">
          <div class="diptych-header">
            <div class="diptych-meta">
              <span class="badge">shoal</span>
              <span class="diptych-version">v0.4.0</span>
            </div>
            <h3 class="diptych-name">daily-ops</h3>
            <p class="diptych-tagline">Daily Operations Squad</p>
          </div>

          <p class="diptych-desc">
            5 agents handle your daily operations. Email triage every 5 minutes.
            Morning briefing at 7am. Research and content on demand.
            You talk to the Chief of Staff — it coordinates the rest.
          </p>

          <!-- Hub-and-spoke SVG topology -->
          <div class="diptych-topology">
            <svg viewBox="0 0 320 200" class="topo-svg" aria-label="daily-ops hub-and-spoke topology">
              <!-- Spokes (lines from hub to agents) -->
              <line x1="160" y1="52" x2="60" y2="155" class="topo-edge" />
              <line x1="160" y1="52" x2="120" y2="170" class="topo-edge" />
              <line x1="160" y1="52" x2="200" y2="170" class="topo-edge" />
              <line x1="160" y1="52" x2="260" y2="155" class="topo-edge" />
              <!-- Hub node -->
              <rect x="110" y="28" width="100" height="36" rx="8" class="topo-node topo-hub" />
              <text x="160" y="44" class="topo-label topo-label-hub">Chief of Staff</text>
              <text x="160" y="57" class="topo-sublabel">Orchestrator</text>
              <!-- Spoke nodes -->
              <rect x="14" y="140" width="92" height="36" rx="8" class="topo-node" />
              <text x="60" y="156" class="topo-label">Inbox Mgr</text>
              <text x="60" y="169" class="topo-sublabel">Every 5min</text>

              <rect x="78" y="158" width="84" height="36" rx="8" class="topo-node" />
              <text x="120" y="174" class="topo-label">Research</text>
              <text x="120" y="187" class="topo-sublabel">On demand</text>

              <rect x="158" y="158" width="84" height="36" rx="8" class="topo-node" />
              <text x="200" y="174" class="topo-label">Writer</text>
              <text x="200" y="187" class="topo-sublabel">8am + demand</text>

              <rect x="214" y="140" width="92" height="36" rx="8" class="topo-node" />
              <text x="260" y="156" class="topo-label">Briefing</text>
              <text x="260" y="169" class="topo-sublabel">7am daily</text>
            </svg>
          </div>

          <div class="diptych-stats">
            <span>5 agents</span>
            <span class="diptych-stat-sep"></span>
            <span>Anthropic + Google AI</span>
            <span class="diptych-stat-sep"></span>
            <span>4 cron jobs</span>
          </div>

          <div class="diptych-install">
            <div class="terminal terminal-sm">
              <div class="terminal-body">
                <div class="terminal-line">
                  <span class="terminal-prompt">$</span>
                  <span class="terminal-cmd">reef install daily-ops</span>
                </div>
              </div>
            </div>
          </div>

          <a href="https://tide.openreef.ai/formations/daily-ops" class="diptych-link">View on Tide &rarr;</a>
        </div>

        <!-- reef-forge -->
        <div class="diptych-card diptych-coral">
          <div class="diptych-header">
            <div class="diptych-meta">
              <span class="badge badge-coral">shoal</span>
              <span class="diptych-version">v0.2.0</span>
            </div>
            <h3 class="diptych-name">reef-forge</h3>
            <p class="diptych-tagline">The formation that builds formations</p>
          </div>

          <p class="diptych-desc">
            Describe the agent team you need. The Architect coordinates four specialists
            through a structured pipeline: research, SOUL writing, scaffolding, and
            adversarial QA on a different vendor model for cognitive diversity.
          </p>

          <!-- Pipeline SVG topology -->
          <div class="diptych-topology">
            <svg viewBox="0 0 320 200" class="topo-svg" aria-label="reef-forge pipeline topology">
              <!-- Pipeline flow arrows -->
              <line x1="160" y1="48" x2="160" y2="68" class="topo-edge topo-edge-coral" />
              <line x1="160" y1="68" x2="80" y2="92" class="topo-edge topo-edge-coral" />
              <line x1="160" y1="68" x2="240" y2="92" class="topo-edge topo-edge-coral" />
              <line x1="80" y1="120" x2="80" y2="140" class="topo-edge topo-edge-coral" />
              <line x1="240" y1="120" x2="240" y2="140" class="topo-edge topo-edge-coral" />
              <line x1="80" y1="168" x2="160" y2="180" class="topo-edge topo-edge-coral" />
              <line x1="240" y1="168" x2="160" y2="180" class="topo-edge topo-edge-coral" />
              <!-- Architect (top) -->
              <rect x="110" y="20" width="100" height="32" rx="8" class="topo-node topo-hub-coral" />
              <text x="160" y="36" class="topo-label topo-label-hub">Architect</text>
              <text x="160" y="48" class="topo-sublabel">Coordinator</text>
              <!-- Left branch -->
              <rect x="34" y="92" width="92" height="32" rx="8" class="topo-node" />
              <text x="80" y="108" class="topo-label">Researcher</text>
              <text x="80" y="118" class="topo-sublabel">Domain research</text>

              <rect x="34" y="140" width="92" height="32" rx="8" class="topo-node" />
              <text x="80" y="156" class="topo-label">Soul Writer</text>
              <text x="80" y="166" class="topo-sublabel">SOUL.md files</text>
              <!-- Right branch -->
              <rect x="194" y="92" width="92" height="32" rx="8" class="topo-node" />
              <text x="240" y="108" class="topo-label">Builder</text>
              <text x="240" y="118" class="topo-sublabel">Scaffolding</text>

              <rect x="194" y="140" width="92" height="32" rx="8" class="topo-node topo-node-alt" />
              <text x="240" y="156" class="topo-label topo-label-alt">QA</text>
              <text x="240" y="166" class="topo-sublabel">OpenAI · adversarial</text>
              <!-- Output -->
              <rect x="115" y="180" width="90" height="16" rx="4" class="topo-output" />
              <text x="160" y="192" class="topo-output-label">.reef.tar.gz</text>
            </svg>
          </div>

          <div class="diptych-stats">
            <span>5 agents</span>
            <span class="diptych-stat-sep"></span>
            <span>Anthropic + OpenAI</span>
            <span class="diptych-stat-sep"></span>
            <span>Multi-vendor</span>
          </div>

          <div class="diptych-install">
            <div class="terminal terminal-sm">
              <div class="terminal-body">
                <div class="terminal-line">
                  <span class="terminal-prompt">$</span>
                  <span class="terminal-cmd">reef install reef-forge</span>
                </div>
              </div>
            </div>
          </div>

          <a href="https://tide.openreef.ai/formations/reef-forge" class="diptych-link diptych-link-coral">View on Tide &rarr;</a>
        </div>
      </div>
    </section>

    <!-- ═══ How It Works ═══ -->
    <section class="section">
      <h2 class="section-title">How It Works</h2>
      <div class="steps">
        <div class="card step">
          <div class="step-number">1</div>
          <h3>Define</h3>
          <p>Declare your agents, communication topology, skills, variables, and cron jobs in a single <code>reef.json</code> manifest.</p>
        </div>
        <div class="card step">
          <div class="step-number">2</div>
          <h3>Package</h3>
          <p>Bundle the manifest with agent personalities (<code>SOUL.md</code>), knowledge files, and config into a portable <code>.reef.tar.gz</code>.</p>
        </div>
        <div class="card step">
          <div class="step-number">3</div>
          <h3>Deploy</h3>
          <p>Run <code>reef install</code> and the CLI provisions everything on your target platform. Agents, bindings, schedules, and all.</p>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <!-- ═══ What's In a Formation ═══ -->
    <section class="section">
      <h2 class="section-title">What's In a Formation</h2>
      <div class="features-grid">
        <div class="card">
          <h3>reef.json</h3>
          <p>Declarative manifest. Agents, topology, skills, variables, cron. The single source of truth for your team.</p>
        </div>
        <div class="card">
          <h3>SOUL.md</h3>
          <p>Each agent gets a personality file. Define behavior, tone, boundaries, and expertise with variable interpolation.</p>
        </div>
        <div class="card">
          <h3>Communication</h3>
          <p>Wire agents together with <code>agentToAgent</code> adjacency lists. Hub-and-spoke, mesh, chain. Any topology.</p>
        </div>
        <div class="card">
          <h3>Cron Jobs</h3>
          <p>Schedule agent wakeups. Heartbeat checks every 15 minutes, daily briefings at 7am, email triage every 5 minutes.</p>
        </div>
        <div class="card">
          <h3>Knowledge</h3>
          <p><code>static/</code> for reference materials that update with the formation. <code>dynamic/</code> for agent-written data that persists across updates.</p>
        </div>
        <div class="card">
          <h3>Variables</h3>
          <p>Typed, validated configuration. Sensitive values never stored in plaintext. <code>&#123;&#123;USER_NAME&#125;&#125;</code> interpolates everywhere.</p>
        </div>
      </div>
    </section>

    <!-- ═══ CLI Commands ═══ -->
    <section class="section">
      <h2 class="section-title">CLI Commands</h2>
      <div class="cli-grid">
        <div class="card cli-card">
          <h3>Create</h3>
          <code>reef init my-team</code>
          <p>Scaffold a new formation from template</p>
        </div>
        <div class="card cli-card">
          <h3>Validate</h3>
          <code>reef validate ./my-team</code>
          <p>Check schema and structural validity</p>
        </div>
        <div class="card cli-card">
          <h3>Inspect</h3>
          <code>reef inspect ./my-team</code>
          <p>Preview what will be deployed</p>
        </div>
        <div class="card cli-card">
          <h3>Install</h3>
          <code>reef install ./my-team</code>
          <p>Deploy the formation</p>
        </div>
        <div class="card cli-card">
          <h3>Update</h3>
          <code>reef update ./my-team</code>
          <p>Update without losing agent data</p>
        </div>
        <div class="card cli-card">
          <h3>Status</h3>
          <code>reef status my-team</code>
          <p>Check agent health and state</p>
        </div>
      </div>
    </section>

    <!-- ═══ Formation Types ═══ -->
    <section class="section">
      <h2 class="section-title">Scale Your Way</h2>
      <div class="types-grid">
        <div class="card type-card">
          <span class="badge badge-outline">solo</span>
          <h3>Single Agent</h3>
          <p>One focused agent with personality, skills, and scheduling. Perfect for a dedicated assistant or specialist.</p>
        </div>
        <div class="card type-card type-featured">
          <span class="badge">shoal</span>
          <h3>2-5 Agents</h3>
          <p>A small coordinated team with defined roles and communication topology. The sweet spot for most workflows.</p>
        </div>
        <div class="card type-card">
          <span class="badge badge-outline">school</span>
          <h3>6+ Agents</h3>
          <p>Large-scale or dynamically-spawning agent patterns. For complex operations that need many specialized roles.</p>
        </div>
      </div>
    </section>

    <div class="section-divider"></div>

    <!-- ═══ Build & Share ═══ -->
    <section class="section">
      <h2 class="section-title">Build &amp; Share</h2>
      <div class="card author-block">
        <p>
          Build agent teams that others can deploy. Package your formation with <code>reef pack</code>,
          share it as a tarball or publish to the registry. Publish to the <a href="https://tide.openreef.ai/publish">Tide registry</a> and let anyone install your formation with one command.
          Supply-chain integrity built in with
          <code>reef.lock.json</code> and SHA-256 digests.
        </p>
        <div class="pill-row">
          <span class="pill">Semantic Versioning</span>
          <span class="pill">Lockfile Pinning</span>
          <span class="pill">No Code Execution</span>
          <span class="pill">JSON + Markdown Only</span>
          <span class="pill">Pre-install Audit</span>
          <span class="pill">SHA-256 Integrity</span>
        </div>
      </div>
    </section>

    <!-- ═══ Get Started CTA ═══ -->
    <section class="section">
      <div class="card cta-block">
        <h2 class="section-title" style="margin-bottom: 12px;">Get Started</h2>
        <div class="terminal terminal-sm" style="margin-bottom: 20px;">
          <div class="terminal-body">
            <div class="terminal-line">
              <span class="terminal-prompt">$</span>
              <span class="terminal-cmd">npm install -g @openreef/cli</span>
            </div>
          </div>
        </div>
        <div class="cta-row">
          <a href="https://github.com/openreefai/openreef" target="_blank" rel="noopener" class="btn btn-primary">View on GitHub</a>
          <a href="https://tide.openreef.ai" class="btn btn-ghost">Explore Tide Registry</a>
          <a href="https://discord.gg/HaNqc266rS" target="_blank" rel="noopener" class="btn btn-ghost">Join Discord</a>
        </div>
      </div>
    </section>

    <!-- ═══ Footer ═══ -->
    <footer class="footer">
      <nav class="footer-nav">
        <a href="https://github.com/openreefai" target="_blank" rel="noopener">GitHub</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://tide.openreef.ai">Tide Registry</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://discord.gg/HaNqc266rS" target="_blank" rel="noopener">Discord</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://www.reddit.com/r/openreef" target="_blank" rel="noopener">Reddit</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://x.com/openreefai" target="_blank" rel="noopener">X / Twitter</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://x.com/i/communities/2023197502787444994" target="_blank" rel="noopener">X Community</a>
      </nav>
    </footer>
  </main>
</Layout>

<style>
  /* ── Container ── */
  .container {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin: 0 auto;
    padding: 48px 28px 40px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── Sections ── */
  .section {
    margin-bottom: 80px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  .section.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  .section-divider {
    width: 120px;
    height: 1px;
    margin: 0 auto 80px;
    background: linear-gradient(90deg, transparent, var(--reef-bright), var(--cyan-bright), transparent);
    opacity: 0.4;
  }

  /* ── Shared Card ── */
  .card {
    padding: 24px;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px var(--shadow-reef);
  }

  .card h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .card code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--bg-elevated);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--cyan-bright);
  }

  /* ── Badge ── */
  .badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--reef-bright);
    color: var(--bg-deep);
  }

  .badge-outline {
    background: transparent;
    color: var(--reef-bright);
    border: 1px solid var(--reef-bright);
  }

  /* ── Hero ── */
  .hero {
    padding: 72px 0 56px;
    animation: fadeInUp 0.4s ease-out both;
  }

  .hero-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .hero-left {
    text-align: left;
  }

  .hero-icon {
    margin-bottom: 16px;
    position: relative;
    display: inline-block;
  }

  .hero-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59, 125, 255, 0.15) 0%, rgba(0, 229, 204, 0.08) 50%, transparent 70%);
    pointer-events: none;
    animation: heroGlowPulse 6s ease-in-out infinite;
  }

  @keyframes heroGlowPulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.8; }
    50% { transform: translate(-50%, -50%) scale(1.1); opacity: 1; }
  }

  .reef-logo {
    width: 100px;
    height: 100px;
    filter: drop-shadow(0 0 24px var(--shadow-reef));
    animation: glow 4s ease-in-out infinite;
    position: relative;
  }

  @keyframes glow {
    0%, 100% { filter: drop-shadow(0 0 16px var(--shadow-reef)); }
    50% { filter: drop-shadow(0 0 32px rgba(59, 125, 255, 0.35)); }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .hero-tagline {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    background: linear-gradient(90deg, var(--reef-bright), var(--cyan-bright));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-top: 4px;
  }

  .hero-description {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 480px;
    margin: 16px 0 0;
  }

  .hero-cta-row {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  /* ── Bot Card ── */
  .hero-bot-card {
    border-radius: 12px;
    border: 1px solid transparent;
    background:
      linear-gradient(var(--surface-card), var(--surface-card)) padding-box,
      linear-gradient(135deg, var(--reef-bright), var(--cyan-bright)) border-box;
    overflow: hidden;
  }

  .bot-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .bot-card-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .bot-card-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan-bright);
    animation: dotPulse 2s ease-in-out infinite;
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; box-shadow: 0 0 8px var(--cyan-bright); }
  }

  .bot-card-body {
    padding: 20px;
  }

  .bot-card-intro {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  .bot-card-prompt {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg-deep);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 20px;
  }

  .bot-card-prompt code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--cyan-bright);
    flex: 1;
    word-break: break-all;
  }

  .bot-card-copy {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 3px 10px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .bot-card-copy:hover {
    color: var(--text-primary);
    border-color: var(--reef-bright);
  }

  .bot-card-result-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .bot-card-routes {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }

  .bot-card-route {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--text-primary);
    padding: 8px 12px;
    border-radius: 6px;
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    transition: border-color 0.2s ease, transform 0.15s ease;
  }

  .bot-card-route:hover {
    border-color: var(--reef-bright);
    transform: translateX(4px);
  }

  .route-icon {
    color: var(--reef-bright);
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .bot-card-footnote {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: italic;
  }

  /* ── CLI Paths ── */
  .cli-section {
    margin-top: -24px;
  }

  .cli-connector {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 16px;
    letter-spacing: 0.01em;
  }

  .cli-prereq {
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    margin-bottom: 24px;
    padding: 10px 20px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    display: inline-flex;
    gap: 8px;
    margin-left: 50%;
    transform: translateX(-50%);
  }

  .cli-paths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .cli-path-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
    font-weight: 600;
  }

  .cli-paths .terminal {
    max-width: 100%;
    margin: 0;
  }

  /* ── Terminal ── */
  .terminal {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    overflow: hidden;
    text-align: left;
    max-width: 520px;
    margin: 0 auto 28px;
  }

  .terminal-sm {
    max-width: 100%;
    margin: 0;
  }

  .terminal-header {
    padding: 8px 14px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .terminal-body {
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .terminal-line {
    white-space: nowrap;
  }

  .terminal-prompt {
    color: var(--reef-bright);
    margin-right: 8px;
  }

  .terminal-cmd {
    color: var(--text-primary);
  }

  .terminal-comment {
    color: var(--text-muted);
  }

  .terminal-spacer {
    height: 8px;
  }

  .terminal-output {
    margin-top: 4px;
  }

  .terminal-success {
    color: var(--cyan-bright);
  }

  /* Terminal reveal animation */
  .terminal-reveal-line {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.3s ease-out, transform 0.3s ease-out;
  }

  .terminal-animate .terminal-reveal-line {
    opacity: 1;
    transform: translateX(0);
  }

  /* Terminal copy button */
  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .terminal-copy-btn {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    padding: 2px 8px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .terminal-copy-btn:hover {
    color: var(--text-primary);
    border-color: var(--reef-bright);
  }

  /* ── CTA Row ── */
  .cta-row {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .btn {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
    letter-spacing: -0.01em;
  }

  .btn-primary {
    background: var(--reef-bright);
    color: #fff;
    border: none;
  }

  .btn-primary:hover {
    background: var(--reef-mid);
    color: #fff;
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-coral {
    background: var(--coral-bright);
    color: #fff;
    border: none;
  }

  .btn-coral:hover {
    background: var(--coral-mid);
    color: #fff;
  }

  .btn-ghost:hover {
    border-color: var(--text-muted);
    color: var(--text-primary);
  }

  /* ── Comparison ── */
  .comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .comparison-before ul,
  .comparison-after ul {
    list-style: none;
    padding: 0;
  }

  .comparison-before li,
  .comparison-after li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding: 4px 0;
    padding-left: 20px;
    position: relative;
  }

  .comparison-before li::before {
    content: '\2717';
    position: absolute;
    left: 0;
    color: var(--coral-bright);
  }

  .comparison-after li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--cyan-bright);
  }

  .comparison-after {
    border-color: var(--border-accent);
  }

  .comparison-after h3 {
    color: var(--reef-bright);
  }

  .inline-code {
    background: var(--bg-elevated);
    padding: 10px 14px;
    border-radius: 6px;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }

  .comparison-after p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  /* ── Steps ── */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--reef-bright);
    margin-bottom: 8px;
    line-height: 1;
  }

  /* ── Section Subtitle ── */
  .section-subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: -16px;
    margin-bottom: 28px;
  }

  .badge-coral {
    background: var(--coral-bright);
  }

  /* ── Formations Diptych ── */
  .formations-diptych {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .diptych-card {
    border-radius: 14px;
    border: 1px solid transparent;
    padding: 28px 24px 24px;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .diptych-card:hover {
    transform: translateY(-3px);
  }

  .diptych-blue {
    background:
      linear-gradient(var(--surface-card), var(--surface-card)) padding-box,
      linear-gradient(160deg, var(--reef-bright), var(--cyan-bright)) border-box;
  }

  .diptych-blue:hover {
    box-shadow: 0 12px 40px rgba(59, 125, 255, 0.15);
  }

  .diptych-coral {
    background:
      linear-gradient(var(--surface-card), var(--surface-card)) padding-box,
      linear-gradient(160deg, var(--coral-bright), var(--reef-bright)) border-box;
  }

  .diptych-coral:hover {
    box-shadow: 0 12px 40px rgba(255, 111, 97, 0.12);
  }

  .diptych-header {
    margin-bottom: 16px;
  }

  .diptych-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .diptych-version {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .diptych-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 4px;
  }

  .diptych-tagline {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .diptych-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 20px;
  }

  /* ── SVG Topology ── */
  .diptych-topology {
    background: var(--bg-deep);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    padding: 12px 8px 8px;
    margin-bottom: 16px;
  }

  .topo-svg {
    width: 100%;
    height: auto;
  }

  .topo-edge {
    stroke: var(--reef-bright);
    stroke-width: 1.5;
    stroke-dasharray: 5 3;
    stroke-opacity: 0.35;
    animation: topoFlow 2.5s linear infinite;
  }

  .topo-edge-coral {
    stroke: var(--coral-bright);
  }

  @keyframes topoFlow {
    to { stroke-dashoffset: -16; }
  }

  .topo-node {
    fill: var(--bg-elevated);
    stroke: var(--border-subtle);
    stroke-width: 1;
  }

  .topo-hub {
    stroke: var(--reef-bright);
    stroke-width: 1.5;
    fill: var(--bg-elevated);
  }

  .topo-hub-coral {
    stroke: var(--coral-bright);
    stroke-width: 1.5;
    fill: var(--bg-elevated);
  }

  .topo-node-alt {
    stroke: var(--coral-bright);
    stroke-width: 1;
    stroke-dasharray: 3 2;
  }

  .topo-label {
    font-family: var(--font-display);
    font-size: 8px;
    font-weight: 700;
    fill: var(--text-primary);
    text-anchor: middle;
    dominant-baseline: central;
  }

  .topo-label-hub {
    fill: var(--reef-bright);
  }

  .topo-label-alt {
    fill: var(--coral-bright);
  }

  .topo-sublabel {
    font-family: var(--font-mono);
    font-size: 6px;
    fill: var(--text-muted);
    text-anchor: middle;
    dominant-baseline: central;
  }

  .topo-output {
    fill: var(--bg-elevated);
    stroke: var(--cyan-bright);
    stroke-width: 1;
    stroke-dasharray: 3 2;
  }

  .topo-output-label {
    font-family: var(--font-mono);
    font-size: 6.5px;
    fill: var(--cyan-bright);
    text-anchor: middle;
    dominant-baseline: central;
  }

  /* ── Stats row ── */
  .diptych-stats {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .diptych-stat-sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-muted);
    opacity: 0.5;
  }

  /* ── Install + link ── */
  .diptych-install {
    margin-bottom: 12px;
  }

  .diptych-install .terminal-sm {
    margin: 0;
  }

  .diptych-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--reef-bright);
    font-weight: 600;
    letter-spacing: 0.01em;
    transition: color 0.2s ease;
    margin-top: auto;
  }

  .diptych-link:hover {
    color: var(--cyan-bright);
  }

  .diptych-link-coral {
    color: var(--coral-bright);
  }

  .diptych-link-coral:hover {
    color: var(--reef-bright);
  }

  /* ── Features Grid ── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  /* ── CLI Grid ── */
  .cli-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .cli-card code {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--bg-elevated);
    padding: 8px 12px;
    border-radius: 6px;
    color: var(--cyan-bright);
    margin-bottom: 8px;
  }

  .cli-card p {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* ── Types Grid ── */
  .types-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .type-card {
    text-align: center;
  }

  .type-card .badge {
    margin-bottom: 12px;
    display: inline-block;
  }

  .type-featured {
    border: 1px solid transparent;
    background:
      linear-gradient(var(--surface-card), var(--surface-card)) padding-box,
      linear-gradient(135deg, var(--reef-bright), var(--coral-bright)) border-box;
  }

  /* ── Section Featured Background ── */
  .section-featured {
    position: relative;
  }
  .section-featured::before {
    content: '';
    position: absolute;
    inset: -40px -40px;
    background: radial-gradient(ellipse at center, rgba(59, 125, 255, 0.04), transparent 70%);
    border-radius: 24px;
    pointer-events: none;
    z-index: -1;
  }

  /* ── Author Block ── */
  .author-block p {
    margin-bottom: 20px;
  }

  .pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 5px 12px;
    border-radius: 6px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    color: var(--text-muted);
  }

  /* ── CTA Block ── */
  .cta-block {
    text-align: center;
    border-color: var(--border-accent);
  }

  .cta-block .terminal-sm {
    max-width: 400px;
    margin: 0 auto 20px;
  }

  /* ── Footer ── */
  .footer {
    margin-top: auto;
    padding-top: 40px;
    padding-bottom: 24px;
    text-align: center;
  }

  .footer-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .footer-nav a {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-nav a:hover {
    color: var(--reef-bright);
  }

  .footer-sep {
    color: var(--text-muted);
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .hero-columns {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .hero-left {
      text-align: center;
    }

    .hero-description {
      margin: 16px auto 0;
    }

    .hero-cta-row {
      justify-content: center;
    }

    .cli-paths {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .container {
      padding: 32px 16px 32px;
    }

    .comparison {
      grid-template-columns: 1fr;
    }

    .steps {
      grid-template-columns: 1fr;
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cli-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .types-grid {
      grid-template-columns: 1fr;
    }

    .formations-diptych {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .features-grid {
      grid-template-columns: 1fr;
    }

    .cli-grid {
      grid-template-columns: 1fr;
    }

    .cta-row {
      flex-direction: column;
      align-items: center;
    }

    .terminal {
