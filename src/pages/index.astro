---
import Layout from '../layouts/Layout.astro';
---

<Layout title="OpenReef - The Open Standard for Multi-Agent Formations">
  <main class="container">
    <!-- ═══ Hero ═══ -->
    <section class="hero">
      <div class="hero-icon">
        <svg viewBox="0 0 100 100" class="reef-logo" aria-hidden="true">
          <defs>
            <linearGradient id="reef-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#3b7dff" />
              <stop offset="50%" style="stop-color:#00e5cc" />
              <stop offset="100%" style="stop-color:#ff6f61" />
            </linearGradient>
          </defs>
          <path d="M50 85 L50 55 M50 55 L35 35 M50 55 L65 35 M35 35 L25 18 M35 35 L42 20 M65 35 L58 20 M65 35 L75 18 M50 55 L50 30 M50 30 L43 15 M50 30 L57 15" stroke="url(#reef-grad)" stroke-width="4" stroke-linecap="round" fill="none" />
          <ellipse cx="50" cy="88" rx="18" ry="4" fill="url(#reef-grad)" opacity="0.3" />
        </svg>
      </div>

      <h1 class="hero-title">OpenReef</h1>
      <p class="hero-tagline">Agent teams as code</p>
      <p class="hero-description">
        Stop hand-wiring AI agents. Define your team in one manifest, deploy in seconds.
        One format, any runtime. Ships today with <a href="https://www.openclaw.ai" target="_blank" rel="noopener">OpenClaw</a> support.
      </p>
    </section>

    <!-- ═══ Quick Start ═══ -->
    <section class="section" id="quick-start" style="animation-delay: 0.1s">
      <h2 class="section-title">Quick Start</h2>

      <div class="terminal">
        <div class="terminal-header">
          <span class="terminal-label">terminal</span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-comment"># Install the CLI</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">npm install -g @openreef/cli</span>
          </div>
          <div class="terminal-spacer"></div>
          <div class="terminal-line">
            <span class="terminal-comment"># Scaffold a new formation</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">reef init my-team</span>
          </div>
          <div class="terminal-spacer"></div>
          <div class="terminal-line">
            <span class="terminal-comment"># Validate and deploy</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">reef validate ./my-team</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">reef install ./my-team</span>
          </div>
          <div class="terminal-output">
            <span class="terminal-success">✓ Formation "my-team" deployed successfully</span>
          </div>
        </div>
      </div>

      <div class="cta-row">
        <a href="https://github.com/openreefai" target="_blank" rel="noopener" class="btn btn-primary">GitHub</a>
        <a href="https://discord.gg/HaNqc266rS" target="_blank" rel="noopener" class="btn btn-ghost">Discord</a>
      </div>
    </section>

    <!-- ═══ What It Does ═══ -->
    <section class="section" style="animation-delay: 0.2s">
      <h2 class="section-title">What It Does</h2>
      <div class="comparison">
        <div class="card comparison-before">
          <h3>Without OpenReef</h3>
          <ul>
            <li>Manually create each agent</li>
            <li>Write personality files one by one</li>
            <li>Wire inter-agent communication by hand</li>
            <li>Configure tools for each agent</li>
            <li>Set up cron jobs individually</li>
            <li>No way to share, reproduce, or version your setup</li>
          </ul>
        </div>
        <div class="card comparison-after">
          <h3>With OpenReef</h3>
          <div class="inline-code">
            <code><span class="terminal-prompt">$</span> reef install daily-ops</code>
          </div>
          <p>5 agents. Wired up. Scheduled. Running. In seconds.</p>
          <ul>
            <li>One declarative manifest</li>
            <li>Reproducible every time</li>
            <li>Shareable and versionable</li>
            <li>Safe - no code execution, just data</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══ Featured Formation: daily-ops ═══ -->
    <section class="section" style="animation-delay: 0.3s">
      <h2 class="section-title">Featured Formation</h2>
      <div class="formation-showcase">
        <div class="formation-header">
          <span class="badge">shoal</span>
          <h3>daily-ops</h3>
        </div>
        <p class="formation-subtitle">Founder's Daily Operations Squad</p>

        <p class="formation-description">
          A 5-agent team that handles your daily operations. Email triage every 5 minutes.
          Morning briefing at 7am. Research on demand. Content drafts in your voice.
          You focus on strategy. Your agents handle the rest.
        </p>

        <div class="agent-topology">
          <div class="agent-node agent-hub">
            <div class="agent-icon">&#9878;</div>
            <span>Chief of Staff</span>
            <small>Orchestrator</small>
          </div>
          <div class="topology-connector"></div>
          <div class="agent-spokes">
            <div class="agent-node">
              <div class="agent-icon">&#9993;</div>
              <span>Inbox Manager</span>
              <small>Every 5min</small>
            </div>
            <div class="agent-node">
              <div class="agent-icon">&#128269;</div>
              <span>Research Analyst</span>
              <small>On demand</small>
            </div>
            <div class="agent-node">
              <div class="agent-icon">&#9998;</div>
              <span>Content Writer</span>
              <small>Daily + on demand</small>
            </div>
            <div class="agent-node">
              <div class="agent-icon">&#9730;</div>
              <span>Daily Briefing</span>
              <small>7am daily</small>
            </div>
          </div>
        </div>

        <div class="terminal terminal-sm">
          <div class="terminal-body">
            <div class="terminal-line">
              <span class="terminal-prompt">$</span>
              <span class="terminal-cmd">reef install daily-ops \</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-cmd">    --var FOUNDER_NAME="Ada" \</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-cmd">    --var BUSINESS_NAME="Lovelace Labs"</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ How It Works ═══ -->
    <section class="section" style="animation-delay: 0.4s">
      <h2 class="section-title">How It Works</h2>
      <div class="steps">
        <div class="card step">
          <div class="step-number">1</div>
          <h3>Define</h3>
          <p>Declare your agents, communication topology, skills, variables, and cron jobs in a single <code>reef.json</code> manifest.</p>
        </div>
        <div class="card step">
          <div class="step-number">2</div>
          <h3>Package</h3>
          <p>Bundle the manifest with agent personalities (<code>SOUL.md</code>), knowledge files, and config into a portable <code>.reef.tar.gz</code>.</p>
        </div>
        <div class="card step">
          <div class="step-number">3</div>
          <h3>Deploy</h3>
          <p>Run <code>reef install</code> and the CLI provisions everything on your target platform. Agents, bindings, schedules, and all.</p>
        </div>
      </div>
    </section>

    <!-- ═══ What's In a Formation ═══ -->
    <section class="section" style="animation-delay: 0.5s">
      <h2 class="section-title">What's In a Formation</h2>
      <div class="features-grid">
        <div class="card">
          <h3>reef.json</h3>
          <p>Declarative manifest. Agents, topology, skills, variables, cron. The single source of truth for your team.</p>
        </div>
        <div class="card">
          <h3>SOUL.md</h3>
          <p>Each agent gets a personality file. Define behavior, tone, boundaries, and expertise with variable interpolation.</p>
        </div>
        <div class="card">
          <h3>Communication</h3>
          <p>Wire agents together with <code>agentToAgent</code> adjacency lists. Hub-and-spoke, mesh, chain. Any topology.</p>
        </div>
        <div class="card">
          <h3>Cron Jobs</h3>
          <p>Schedule agent wakeups. Heartbeat checks every 15 minutes, daily briefings at 7am, email triage every 5 minutes.</p>
        </div>
        <div class="card">
          <h3>Knowledge</h3>
          <p><code>static/</code> for reference materials that update with the formation. <code>dynamic/</code> for agent-written data that persists across updates.</p>
        </div>
        <div class="card">
          <h3>Variables</h3>
          <p>Typed, validated configuration. Sensitive values never stored in plaintext. <code>&#123;&#123;FOUNDER_NAME&#125;&#125;</code> interpolates everywhere.</p>
        </div>
      </div>
    </section>

    <!-- ═══ CLI Commands ═══ -->
    <section class="section" style="animation-delay: 0.6s">
      <h2 class="section-title">CLI Commands</h2>
      <div class="cli-grid">
        <div class="card cli-card">
          <h3>Create</h3>
          <code>reef init my-team</code>
          <p>Scaffold a new formation from template</p>
        </div>
        <div class="card cli-card">
          <h3>Validate</h3>
          <code>reef validate ./my-team</code>
          <p>Check schema and structural validity</p>
        </div>
        <div class="card cli-card">
          <h3>Inspect</h3>
          <code>reef inspect ./my-team</code>
          <p>Preview what will be deployed</p>
        </div>
        <div class="card cli-card">
          <h3>Install</h3>
          <code>reef install ./my-team</code>
          <p>Deploy the formation</p>
        </div>
        <div class="card cli-card">
          <h3>Update</h3>
          <code>reef update ./my-team</code>
          <p>Update without losing agent data</p>
        </div>
        <div class="card cli-card">
          <h3>Status</h3>
          <code>reef status my-team</code>
          <p>Check agent health and state</p>
        </div>
      </div>
    </section>

    <!-- ═══ Formation Types ═══ -->
    <section class="section" style="animation-delay: 0.7s">
      <h2 class="section-title">Scale Your Way</h2>
      <div class="types-grid">
        <div class="card type-card">
          <span class="badge badge-outline">solo</span>
          <h3>Single Agent</h3>
          <p>One focused agent with personality, skills, and scheduling. Perfect for a dedicated assistant or specialist.</p>
        </div>
        <div class="card type-card type-featured">
          <span class="badge">shoal</span>
          <h3>2-5 Agents</h3>
          <p>A small coordinated team with defined roles and communication topology. The sweet spot for most workflows.</p>
        </div>
        <div class="card type-card">
          <span class="badge badge-outline">school</span>
          <h3>6+ Agents</h3>
          <p>Large-scale or dynamically-spawning agent patterns. For complex operations that need many specialized roles.</p>
        </div>
      </div>
    </section>

    <!-- ═══ Build & Share ═══ -->
    <section class="section" style="animation-delay: 0.8s">
      <h2 class="section-title">Build &amp; Share</h2>
      <div class="card author-block">
        <p>
          Build agent teams that others can deploy. Package your formation with <code>reef pack</code>,
          share it as a tarball or publish to the registry. Supply-chain integrity built in with
          <code>reef.lock.json</code> and SHA-256 digests.
        </p>
        <div class="pill-row">
          <span class="pill">Semantic Versioning</span>
          <span class="pill">Lockfile Pinning</span>
          <span class="pill">No Code Execution</span>
          <span class="pill">JSON + Markdown Only</span>
          <span class="pill">Pre-install Audit</span>
          <span class="pill">SHA-256 Integrity</span>
        </div>
      </div>
    </section>

    <!-- ═══ Get Started CTA ═══ -->
    <section class="section" style="animation-delay: 0.9s">
      <div class="card cta-block">
        <h2 class="section-title" style="margin-bottom: 12px;">Get Started</h2>
        <div class="terminal terminal-sm" style="margin-bottom: 20px;">
          <div class="terminal-body">
            <div class="terminal-line">
              <span class="terminal-prompt">$</span>
              <span class="terminal-cmd">npm install -g @openreef/cli</span>
            </div>
          </div>
        </div>
        <div class="cta-row">
          <a href="https://github.com/openreefai/openreef" target="_blank" rel="noopener" class="btn btn-primary">View on GitHub</a>
          <a href="https://discord.gg/HaNqc266rS" target="_blank" rel="noopener" class="btn btn-ghost">Join Discord</a>
        </div>
      </div>
    </section>

    <!-- ═══ Footer ═══ -->
    <footer class="footer">
      <nav class="footer-nav">
        <a href="https://github.com/openreefai" target="_blank" rel="noopener">GitHub</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://discord.gg/HaNqc266rS" target="_blank" rel="noopener">Discord</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://www.reddit.com/r/openreef" target="_blank" rel="noopener">Reddit</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://x.com/openreefai" target="_blank" rel="noopener">X / Twitter</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://x.com/i/communities/2023197502787444994" target="_blank" rel="noopener">X Community</a>
      </nav>
    </footer>
  </main>
</Layout>

<style>
  /* ── Container ── */
  .container {
    position: relative;
    z-index: 1;
    max-width: 960px;
    margin: 0 auto;
    padding: 48px 24px 40px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── Sections ── */
  .section {
    margin-bottom: 72px;
    animation: fadeInUp 0.4s ease-out both;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
  }

  /* ── Shared Card ── */
  .card {
    padding: 24px;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .card:hover {
    border-color: var(--border-accent);
    box-shadow: 0 0 0 1px var(--border-accent);
  }

  .card h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .card code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--bg-elevated);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--cyan-bright);
  }

  /* ── Badge ── */
  .badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--reef-bright);
    color: var(--bg-deep);
  }

  .badge-outline {
    background: transparent;
    color: var(--reef-bright);
    border: 1px solid var(--reef-bright);
  }

  /* ── Hero ── */
  .hero {
    text-align: center;
    padding: 32px 0 40px;
    animation: fadeInUp 0.4s ease-out both;
  }

  .hero-icon {
    margin-bottom: 20px;
  }

  .reef-logo {
    width: 80px;
    height: 80px;
    filter: drop-shadow(0 0 24px var(--shadow-reef));
    animation: glow 4s ease-in-out infinite;
  }

  @keyframes glow {
    0%, 100% { filter: drop-shadow(0 0 16px var(--shadow-reef)); }
    50% { filter: drop-shadow(0 0 32px rgba(59, 125, 255, 0.35)); }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .hero-tagline {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--reef-bright);
    margin-top: 4px;
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 540px;
    margin: 16px auto 0;
  }

  .hero-footnote {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 8px;
  }

  .hero-footnote a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .hero-footnote a:hover {
    color: var(--reef-bright);
  }

  .asterisk {
    color: var(--reef-bright);
  }

  /* ── Terminal ── */
  .terminal {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    overflow: hidden;
    text-align: left;
    max-width: 520px;
    margin: 0 auto 28px;
  }

  .terminal-sm {
    max-width: 100%;
    margin: 0;
  }

  .terminal-header {
    padding: 8px 14px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .terminal-body {
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .terminal-line {
    white-space: nowrap;
  }

  .terminal-prompt {
    color: var(--reef-bright);
    margin-right: 8px;
  }

  .terminal-cmd {
    color: var(--text-primary);
  }

  .terminal-comment {
    color: var(--text-muted);
  }

  .terminal-spacer {
    height: 8px;
  }

  .terminal-output {
    margin-top: 4px;
  }

  .terminal-success {
    color: var(--cyan-bright);
  }

  /* ── CTA Row ── */
  .cta-row {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .btn {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
    letter-spacing: -0.01em;
  }

  .btn-primary {
    background: var(--reef-bright);
    color: #fff;
    border: none;
  }

  .btn-primary:hover {
    background: var(--reef-mid);
    color: #fff;
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-ghost:hover {
    border-color: var(--text-muted);
    color: var(--text-primary);
  }

  /* ── Comparison ── */
  .comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .comparison-before ul,
  .comparison-after ul {
    list-style: none;
    padding: 0;
  }

  .comparison-before li,
  .comparison-after li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding: 4px 0;
    padding-left: 20px;
    position: relative;
  }

  .comparison-before li::before {
    content: '\2717';
    position: absolute;
    left: 0;
    color: var(--coral-bright);
  }

  .comparison-after li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--cyan-bright);
  }

  .comparison-after {
    border-color: var(--border-accent);
  }

  .comparison-after h3 {
    color: var(--reef-bright);
  }

  .inline-code {
    background: var(--bg-elevated);
    padding: 10px 14px;
    border-radius: 6px;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
  }

  .comparison-after p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  /* ── Steps ── */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--reef-bright);
    margin-bottom: 8px;
    line-height: 1;
  }

  /* ── Formation Showcase ── */
  .formation-showcase {
    padding: 32px;
    border-radius: 12px;
    border: 1px solid var(--border-accent);
    background: var(--surface-card);
  }

  .formation-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 4px;
  }

  .formation-header h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .formation-subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 16px;
  }

  .formation-description {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 28px;
  }

  /* ── Agent Topology ── */
  .agent-topology {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin-bottom: 28px;
  }

  .agent-hub {
    border-color: var(--reef-bright) !important;
  }

  .topology-connector {
    width: 2px;
    height: 20px;
    background: var(--border-subtle);
  }

  .agent-spokes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    width: 100%;
    border-top: 2px solid var(--border-subtle);
    padding-top: 16px;
  }

  .agent-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 14px 10px;
    border-radius: 10px;
    border: 1px solid var(--border-subtle);
    background: var(--bg-elevated);
    text-align: center;
  }

  .agent-icon {
    font-size: 1.3rem;
    margin-bottom: 2px;
  }

  .agent-node span {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .agent-node small {
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  /* ── Features Grid ── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
