---
import Layout from '../layouts/Layout.astro';
---

<Layout title="OpenReef — Deploy AI Agent Teams in One Command">
  <main class="container">
    <!-- ═══ Hero ═══ -->
    <section class="hero">
      <div class="hero-icon">
        <svg viewBox="0 0 100 100" class="reef-logo" aria-hidden="true">
          <defs>
            <linearGradient id="reef-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#3b7dff" />
              <stop offset="50%" style="stop-color:#00e5cc" />
              <stop offset="100%" style="stop-color:#ff6f61" />
            </linearGradient>
          </defs>
          <path d="M50 85 L50 55 M50 55 L35 35 M50 55 L65 35 M35 35 L25 18 M35 35 L42 20 M65 35 L58 20 M65 35 L75 18 M50 55 L50 30 M50 30 L43 15 M50 30 L57 15" stroke="url(#reef-grad)" stroke-width="4" stroke-linecap="round" fill="none" />
          <ellipse cx="50" cy="88" rx="18" ry="4" fill="url(#reef-grad)" opacity="0.3" />
          <circle cx="30" cy="28" r="2" fill="#00e5cc" opacity="0.6">
            <animate attributeName="cy" values="28;22;28" dur="3s" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0.6;0.2;0.6" dur="3s" repeatCount="indefinite" />
          </circle>
          <circle cx="70" cy="24" r="1.5" fill="#3b7dff" opacity="0.5">
            <animate attributeName="cy" values="24;18;24" dur="4s" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0.5;0.15;0.5" dur="4s" repeatCount="indefinite" />
          </circle>
          <circle cx="52" cy="20" r="1" fill="#ff6f61" opacity="0.4">
            <animate attributeName="cy" values="20;14;20" dur="3.5s" repeatCount="indefinite" />
            <animate attributeName="opacity" values="0.4;0.1;0.4" dur="3.5s" repeatCount="indefinite" />
          </circle>
        </svg>
      </div>

      <h1 class="hero-title">OpenReef</h1>
      <p class="hero-tagline">Agent teams, packaged</p>
      <p class="hero-description">
        Deploy coordinated AI agent teams in one command.
        Define agents, wire communication, schedule tasks, and ship to <a href="https://openclaw.ai" target="_blank" rel="noopener">OpenClaw</a> &mdash; all from a single manifest.
      </p>
    </section>

    <!-- ═══ Quick Start ═══ -->
    <section class="section quickstart" id="quick-start" style="animation-delay: 0.1s">
      <h2 class="section-title"><span class="reef-accent">&#x27E9;</span> Quick Start</h2>

      <div class="quickstart-terminal">
        <div class="terminal-bar">
          <span class="terminal-dot red"></span>
          <span class="terminal-dot yellow"></span>
          <span class="terminal-dot green"></span>
          <span class="terminal-title">terminal</span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="terminal-comment"># Install the CLI</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">npm install -g @openreef/cli</span>
          </div>
          <div class="terminal-spacer"></div>
          <div class="terminal-line">
            <span class="terminal-comment"># Scaffold a new formation</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">reef init my-team</span>
          </div>
          <div class="terminal-spacer"></div>
          <div class="terminal-line">
            <span class="terminal-comment"># Validate and deploy</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">reef validate ./my-team</span>
          </div>
          <div class="terminal-line">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cmd">reef install ./my-team</span>
          </div>
          <div class="terminal-output terminal-final">
            <span class="terminal-success">  ✓ Formation "my-team" deployed successfully</span>
          </div>
        </div>
      </div>

      <div class="hero-ctas">
        <a href="https://github.com/openreef" target="_blank" rel="noopener" class="btn btn-primary">GitHub</a>
        <a href="https://discord.gg/HaNqc266rS" target="_blank" rel="noopener" class="btn btn-secondary">Discord</a>
      </div>
    </section>

    <!-- ═══ What It Does ═══ -->
    <section class="section" style="animation-delay: 0.2s">
      <h2 class="section-title"><span class="reef-accent">&#x27E9;</span> What It Does</h2>
      <div class="comparison">
        <div class="comparison-card comparison-before">
          <h3>Without OpenReef</h3>
          <ul>
            <li>Manually create each agent</li>
            <li>Write personality files one by one</li>
            <li>Wire inter-agent communication by hand</li>
            <li>Configure tools for each agent</li>
            <li>Set up cron jobs individually</li>
            <li>No way to share, reproduce, or version your setup</li>
          </ul>
        </div>
        <div class="comparison-card comparison-after">
          <h3>With OpenReef</h3>
          <div class="comparison-terminal">
            <code><span class="terminal-prompt">$</span> reef install daily-ops</code>
          </div>
          <p>5 agents. Wired up. Scheduled. Running. In seconds.</p>
          <ul>
            <li>One declarative manifest</li>
            <li>Reproducible every time</li>
            <li>Shareable and versionable</li>
            <li>Safe — no code execution, just data</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══ How It Works ═══ -->
    <section class="section" style="animation-delay: 0.3s">
      <h2 class="section-title"><span class="reef-accent">&#x27E9;</span> How It Works</h2>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <h3>Define</h3>
          <p>Declare your agents, communication topology, skills, variables, and cron jobs in a single <code>reef.json</code> manifest.</p>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h3>Package</h3>
          <p>Bundle the manifest with agent personalities (<code>SOUL.md</code>), knowledge files, and config into a portable <code>.reef.tar.gz</code>.</p>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h3>Deploy</h3>
          <p>Run <code>reef install</code> and the CLI provisions everything on your OpenClaw instance — agents, bindings, schedules, and all.</p>
        </div>
      </div>
    </section>

    <!-- ═══ Featured Formation: daily-ops ═══ -->
    <section class="section" style="animation-delay: 0.4s">
      <h2 class="section-title"><span class="reef-accent">&#x27E9;</span> Featured Formation</h2>
      <div class="formation-showcase">
        <div class="formation-header">
          <div class="formation-badge">shoal</div>
          <h3>daily-ops</h3>
          <p class="formation-subtitle">Founder's Daily Operations Squad</p>
        </div>

        <p class="formation-description">
          A 5-agent team that handles your daily operations. Email triage every 5 minutes.
          Morning briefing at 7am. Research on demand. Content drafts in your voice.
          You focus on strategy — your agents handle the rest.
        </p>

        <div class="agent-topology">
          <div class="agent-node agent-hub">
            <div class="agent-icon">&#9878;</div>
            <span>Chief of Staff</span>
            <small>Orchestrator</small>
          </div>
          <div class="topology-lines">
            <div class="topology-line"></div>
            <div class="topology-line"></div>
            <div class="topology-line"></div>
            <div class="topology-line"></div>
          </div>
          <div class="agent-spokes">
            <div class="agent-node">
              <div class="agent-icon">&#9993;</div>
              <span>Inbox Manager</span>
              <small>Every 5min</small>
            </div>
            <div class="agent-node">
              <div class="agent-icon">&#128269;</div>
              <span>Research Analyst</span>
              <small>On demand</small>
            </div>
            <div class="agent-node">
              <div class="agent-icon">&#9998;</div>
              <span>Content Writer</span>
              <small>Daily + on demand</small>
            </div>
            <div class="agent-node">
              <div class="agent-icon">&#9730;</div>
              <span>Daily Briefing</span>
              <small>7am daily</small>
            </div>
          </div>
        </div>

        <div class="formation-install">
          <div class="terminal-bar">
            <span class="terminal-dot red"></span>
            <span class="terminal-dot yellow"></span>
            <span class="terminal-dot green"></span>
          </div>
          <div class="terminal-body compact">
            <div class="terminal-line">
              <span class="terminal-prompt">$</span>
              <span class="terminal-cmd">reef install daily-ops \</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-cmd">    --var FOUNDER_NAME="Ada" \</span>
            </div>
            <div class="terminal-line">
              <span class="terminal-cmd">    --var BUSINESS_NAME="Lovelace Labs"</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ What's In a Formation ═══ -->
    <section class="section" style="animation-delay: 0.5s">
      <h2 class="section-title"><span class="reef-accent">&#x27E9;</span> What's In a Formation</h2>
      <div class="features-grid">
        <div class="feature-card">
          <h3>reef.json</h3>
          <p>Declarative manifest — agents, topology, skills, variables, cron. The single source of truth for your team.</p>
        </div>
        <div class="feature-card">
          <h3>SOUL.md</h3>
          <p>Each agent gets a personality file. Define behavior, tone, boundaries, and expertise with variable interpolation.</p>
        </div>
        <div class="feature-card">
          <h3>Communication</h3>
          <p>Wire agents together with <code>agentToAgent</code> adjacency lists. Hub-and-spoke, mesh, chain — any topology.</p>
        </div>
        <div class="feature-card">
          <h3>Cron Jobs</h3>
          <p>Schedule agent wakeups. Heartbeat checks every 15 minutes, daily briefings at 7am, email triage every 5 minutes.</p>
        </div>
        <div class="feature-card">
          <h3>Knowledge</h3>
          <p><code>static/</code> for reference materials that update with the formation. <code>dynamic/</code> for agent-written data that persists across updates.</p>
        </div>
        <div class="feature-card">
          <h3>Variables</h3>
          <p>Typed, validated configuration. Sensitive values never stored in plaintext. <code>&#123;&#123;FOUNDER_NAME&#125;&#125;</code> interpolates everywhere.</p>
        </div>
      </div>
    </section>

    <!-- ═══ CLI Commands ═══ -->
    <section class="section" style="animation-delay: 0.6s">
      <h2 class="section-title"><span class="reef-accent">&#x27E9;</span> CLI Commands</h2>
      <div class="cli-grid">
        <div class="cli-card">
          <h3>Create</h3>
          <code>reef init my-team</code>
          <p>Scaffold a new formation from template</p>
        </div>
        <div class="cli-card">
          <h3>Validate</h3>
          <code>reef validate ./my-team</code>
          <p>Check schema and structural validity</p>
        </div>
        <div class="cli-card">
          <h3>Inspect</h3>
          <code>reef inspect ./my-team</code>
          <p>Preview what will be deployed</p>
        </div>
        <div class="cli-card">
          <h3>Install</h3>
          <code>reef install ./my-team</code>
          <p>Deploy the formation</p>
        </div>
        <div class="cli-card">
          <h3>Update</h3>
          <code>reef update ./my-team</code>
          <p>Update without losing agent data</p>
        </div>
        <div class="cli-card">
          <h3>Status</h3>
          <code>reef status my-team</code>
          <p>Check agent health and state</p>
        </div>
      </div>
    </section>

    <!-- ═══ Formation Types ═══ -->
    <section class="section" style="animation-delay: 0.7s">
      <h2 class="section-title"><span class="reef-accent">&#x27E9;</span> Scale Your Way</h2>
      <div class="types-grid">
        <div class="type-card">
          <div class="type-label">solo</div>
          <h3>Single Agent</h3>
          <p>One focused agent with personality, skills, and scheduling. Perfect for a dedicated assistant or specialist.</p>
        </div>
        <div class="type-card type-featured">
          <div class="type-label">shoal</div>
          <h3>2–5 Agents</h3>
          <p>A small coordinated team with defined roles and communication topology. The sweet spot for most workflows.</p>
        </div>
        <div class="type-card">
          <div class="type-label">school</div>
          <h3>6+ Agents</h3>
          <p>Large-scale or dynamically-spawning agent patterns. For complex operations that need many specialized roles.</p>
        </div>
      </div>
    </section>

    <!-- ═══ Build & Share ═══ -->
    <section class="section" style="animation-delay: 0.8s">
      <h2 class="section-title"><span class="reef-accent">&#x27E9;</span> Build &amp; Share</h2>
      <div class="author-block">
        <p>
          Build agent teams that others can deploy. Package your formation with <code>reef pack</code>,
          share it as a tarball or publish to the registry. Supply-chain integrity built in with
          <code>reef.lock.json</code> and SHA-256 digests.
        </p>
        <div class="author-features">
          <span class="pill">Semantic Versioning</span>
          <span class="pill">Lockfile Pinning</span>
          <span class="pill">No Code Execution</span>
          <span class="pill">JSON + Markdown Only</span>
          <span class="pill">Pre-install Audit</span>
          <span class="pill">SHA-256 Integrity</span>
        </div>
      </div>
    </section>

    <!-- ═══ Footer ═══ -->
    <footer class="footer">
      <nav class="footer-nav">
        <a href="https://github.com/openreef" target="_blank" rel="noopener">GitHub</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://discord.gg/HaNqc266rS" target="_blank" rel="noopener">Discord</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://www.reddit.com/r/openreef" target="_blank" rel="noopener">Reddit</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://x.com/openreefai" target="_blank" rel="noopener">X / Twitter</a>
        <span class="footer-sep">&middot;</span>
        <a href="https://x.com/i/communities/2023197502787444994" target="_blank" rel="noopener">X Community</a>
      </nav>
    </footer>
  </main>
</Layout>

<style>
  /* ── Container ── */
  .container {
    position: relative;
    z-index: 1;
    max-width: 880px;
    margin: 0 auto;
    padding: 60px 24px 40px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── Sections ── */
  .section {
    margin-bottom: 64px;
    animation: fadeInUp 0.5s ease-out both;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .reef-accent {
    color: var(--reef-bright);
    font-weight: 700;
  }

  /* ── Hero ── */
  .hero {
    text-align: center;
    padding: 40px 0 32px;
    animation: fadeInUp 0.5s ease-out both;
  }

  .hero-icon {
    margin-bottom: 24px;
  }

  .reef-logo {
    width: 100px;
    height: 100px;
    filter: drop-shadow(0 0 20px var(--shadow-reef));
    animation: float 4s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--reef-bright), var(--cyan-bright), var(--coral-bright));
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 6s ease infinite;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .hero-tagline {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--reef-bright);
    margin-top: 8px;
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 560px;
    margin: 16px auto 0;
  }

  /* ── Quick Start ── */
  .quickstart-terminal {
    background: var(--surface-card-strong);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    overflow: hidden;
    text-align: left;
    max-width: 520px;
    margin: 0 auto 28px;
    backdrop-filter: blur(12px);
  }

  /* ── Terminal Blocks ── */
  .quickstart-terminal,
  .formation-install {
    background: var(--surface-card-strong);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    overflow: hidden;
    text-align: left;
    backdrop-filter: blur(12px);
  }

  .formation-install {
    margin: 0;
    max-width: 100%;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: #ff5f57; }
  .terminal-dot.yellow { background: #febc2e; }
  .terminal-dot.green { background: #28c840; }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-left: 8px;
  }

  .terminal-body {
    padding: 16px 18px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .terminal-body.compact {
    padding: 14px 18px;
  }

  .terminal-line {
    white-space: nowrap;
  }

  .terminal-prompt {
    color: var(--coral-bright);
    margin-right: 8px;
  }

  .terminal-cmd {
    color: var(--cyan-bright);
  }

  .terminal-comment {
    color: var(--text-muted);
    font-style: italic;
  }

  .terminal-spacer {
    height: 8px;
  }

  .terminal-output {
    color: var(--text-muted);
  }

  .terminal-muted {
    color: var(--text-muted);
  }

  .terminal-success {
    color: var(--cyan-bright);
  }

  .terminal-final {
    margin-top: 4px;
  }

  /* ── Hero CTAs ── */
  .hero-ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .btn {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    padding: 14px 28px;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--reef-bright), var(--reef-dark));
    color: #fff;
    border: none;
    box-shadow: 0 4px 20px var(--shadow-reef);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px var(--shadow-reef);
    color: #fff;
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
  }

  .btn-secondary:hover {
    border-color: var(--reef-bright);
    color: var(--reef-bright);
    transform: translateY(-2px);
  }

  /* ── Problem / Solution ── */
  .comparison {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .comparison-card {
    padding: 24px;
    border-radius: 14px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    backdrop-filter: blur(12px);
  }

  .comparison-card h3 {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .comparison-card ul {
    list-style: none;
    padding: 0;
  }

  .comparison-card li {
    font-size: 0.9rem;
    color: var(--text-secondary);
    padding: 4px 0;
    padding-left: 20px;
    position: relative;
  }

  .comparison-before li::before {
    content: '\2717';
    position: absolute;
    left: 0;
    color: var(--coral-bright);
  }

  .comparison-after li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--cyan-bright);
  }

  .comparison-after {
    border-color: rgba(59, 125, 255, 0.2);
    background: rgba(59, 125, 255, 0.05);
  }

  .comparison-after h3 {
    color: var(--reef-bright);
  }

  .comparison-terminal {
    background: var(--bg-elevated);
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .comparison-after p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }

  /* ── How It Works ── */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .step {
    padding: 24px;
    border-radius: 14px;
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    backdrop-filter: blur(12px);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .step:hover {
    transform: translateY(-4px);
    border-color: var(--reef-bright);
    box-shadow: 0 12px 40px var(--shadow-reef);
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--reef-bright);
    margin-bottom: 8px;
  }

  .step h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .step p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .step code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    background: var(--bg-elevated);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--cyan-bright);
  }

  /* ── Formation Showcase ── */
  .formation-showcase {
    padding: 32px;
    border-radius: 16px;
    border: 1px solid rgba(59, 125, 255, 0.2);
    background: linear-gradient(135deg, rgba(59, 125, 255, 0.05), rgba(0, 229, 204, 0.03));
    backdrop-filter: blur(12px);
  }

  .formation-header {
    display: flex;
